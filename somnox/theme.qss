/* MD3 Expressive — tokens Material You */
:root {
}
QWidget {
  font-family: "Segoe UI", "Roboto", sans-serif;
  font-size: 14px;
  color: #1D1B20;
}
QMainWindow, #root {
  background-color: #FEF7FF;
}
QLabel#appTitle {
  font-size: 28px;
  font-weight: 700;
  color: #6750A4;
  letter-spacing: 0.5px;
}
QLabel#severity {
  font-size: 22px;
  font-weight: 700;
  padding: 12px 20px;
  border-radius: 28px;
  background: #EADDFF;
  color: #4F378B;
}
QLabel#severity[sev="sévère"] { background: #FFDAD6; color: #B3261E; }
QLabel#severity[sev="modérée"] { background: #FFE0B2; color: #8D5000; }
QLabel#severity[sev="légère"] { background: #E8F3D8; color: #33691E; }
QLabel#severity[sev="Non interprétable"] { background: #E7E0EC; color: #49454F; }

QLabel.section {
  font-size: 16px;
  font-weight: 600;
  color: #4F378B;
  margin-top: 12px;
}
QFrame.card {
  background: #FFFFFF;
  border-radius: 24px;
  border: 1px solid #E7E0EC;
}
QFrame#hero {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EADDFF, stop:1 #D0BCFF);
  border-radius: 32px;
}
QPushButton {
  background-color: #6750A4;
  color: #FFFFFF;
  border: none;
  border-radius: 20px;
  padding: 10px 22px;
  font-weight: 600;
}
QPushButton:hover { background-color: #7F67BE; }
QPushButton:pressed { background-color: #5B4494; }
QPushButton#secondary {
  background-color: #EADDFF;
  color: #4F378B;
}
QPushButton#alertBtn {
  background: transparent;
  color: #B3261E;
  text-align: left;
  border-radius: 16px;
  padding: 8px 14px;
}
#previewPanel {
  background: #F4EFF7;
  border-left: 1px solid #E7E0EC;
}
#previewTitle {
  font-size: 15px;
  font-weight: 600;
  color: #4F378B;
  padding: 4px;
}
QScrollArea { border: none; background: transparent; }
QSplitter::handle { background: #E7E0EC; width: 3px; }
QTabWidget::pane { border-radius: 20px; background: #FFFFFF; border: 1px solid #E7E0EC; }
QTabBar::tab {
  background: #E7E0EC;
  border-radius: 16px;
  padding: 8px 18px;
  margin: 4px;
  color: #49454F;
}
QTabBar::tab:selected { background: #6750A4; color: #FFFFFF; }
QPlainTextEdit, QTextBrowser {
  background: #FFFFFF;
  border: 1px solid #E7E0EC;
  border-radius: 16px;
  padding: 12px;
  font-family: "Consolas", monospace;
  font-size: 13px;
}
QStatusBar { background: transparent; color: #49454F; }
