/* Somnox — Material Design 3 expressive */
QWidget {
  font-family: "Segoe UI Variable", "Segoe UI", "Roboto", sans-serif;
  font-size: 14px;
  color: #1D1B20;
}
QMainWindow, #root { background-color: #FEF7FF; }

QLabel#appTitle {
  font-size: 32px;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1px;
}
QLabel {
  color: #49454F;
}
QLabel#heroSubtitle { color: #E8E0F0; font-size: 13px; }

QFrame#hero {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6750A4, stop:1 #9A82DB);
  border-radius: 28px;
}

QLabel#severity {
  font-size: 20px;
  font-weight: 800;
  padding: 10px 24px;
  border-radius: 24px;
  background: #EADDFF;
  color: #4F378B;
}
QLabel#severity[sev="sévère"] { background: #B3261E; color: #FFFFFF; }
QLabel#severity[sev="modérée"] { background: #E8590C; color: #FFFFFF; }
QLabel#severity[sev="légère"] { background: #2E6B1E; color: #FFFFFF; }
QLabel#severity[sev="absente"] { background: #49454F; color: #FFFFFF; }
QLabel#severity[sev="Non interprétable"] { background: #79747E; color: #FFFFFF; }

QFrame.card {
  background: #FFFFFF;
  border-radius: 24px;
  border: 1px solid #E7E0EC;
}

QPushButton {
  background-color: #6750A4;
  color: #FFFFFF;
  border: none;
  border-radius: 22px;
  padding: 11px 26px;
  font-weight: 600;
  font-size: 14px;
}
QPushButton:hover { background-color: #7F67BE; }
QPushButton:pressed { background-color: #5B4494; }
QPushButton:disabled { background-color: #E7E0EC; color: #9A94A0; }
QPushButton#secondary { background-color: #EADDFF; color: #4F378B; }
QPushButton#secondary:hover { background-color: #D0BCFF; }

QGroupBox {
  background: #FFFFFF;
  border: 1px solid #E7E0EC;
  border-radius: 20px;
  margin-top: 14px;
  padding: 12px 10px 10px 10px;
  font-weight: 600;
  color: #4F378B;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 16px;
  padding: 0 6px;
  background: #FEF7FF;
  color: #6750A4;
}

QCheckBox { spacing: 8px; color: #1D1B20; }
QCheckBox::indicator {
  width: 18px; height: 18px;
  border-radius: 6px;
  border: 2px solid #79747E;
  background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #6750A4; border-color: #6750A4; }

QSpinBox, QComboBox {
  background: #FFFFFF;
  border: 1px solid #CAC4D0;
  border-radius: 12px;
  padding: 6px 10px;
  color: #1D1B20;
}
QSpinBox:focus, QComboBox:focus { border: 2px solid #6750A4; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 1px solid #E7E0EC;
  selection-background-color: #EADDFF;
  selection-color: #4F378B;
  border-radius: 12px;
}

QTabWidget::pane {
  border-radius: 22px;
  background: #FFFFFF;
  border: 1px solid #E7E0EC;
}
QTabBar::tab {
  background: transparent;
  color: #49454F;
  border-radius: 18px;
  padding: 9px 20px;
  margin: 5px 2px;
  font-weight: 600;
}
QTabBar::tab:hover { background: #EDE7F4; }
QTabBar::tab:selected { background: #6750A4; color: #FFFFFF; }

QTextBrowser, QPlainTextEdit {
  background: #FFFFFF;
  border: none;
  padding: 16px 20px;
  font-size: 14px;
  selection-background-color: #D0BCFF;
}
QTextBrowser { border-radius: 22px; }

#previewPanel {
  background: #F4EFF7;
  border-left: 1px solid #E7E0EC;
}
#previewTitle { font-size: 13px; font-weight: 600; color: #4F378B; padding: 2px; }
QScrollArea { border: none; background: transparent; }
QSplitter::handle { background: #E7E0EC; width: 3px; }

QStatusBar { background: transparent; color: #49454F; font-size: 13px; }
QStatusBar::item { border: none; }
